# ==========================================
# MyFolio Web Platform - Environment Template
# ==========================================

# === Core AI Engine (Gemini) ===
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# === Dynamic Typography Engine ===
# Google Fonts Developer API key for dynamic font loading
GOOGLE_FONTS_KEY=YOUR_GOOGLE_FONTS_KEY_HERE

# === Security & Password Encryption ===
# Long random string for password hashing pepper
AUTH_PEPPER=YOUR_SECURE_AUTH_PEPPER_HERE

# === Production Host & App Settings ===
# Strict Port Policy: Default 5050 (Never use port 3000)
PORT=5050
NODE_ENV=development
HOST_URL=https://myfolio.tech

# === Super Administrator Accounts ===
ADMIN_EMAILS=abdulaziznoor9876@gmail.com
ADMIN_USERNAMES=abdulazizpro1
ADMIN_IDS=YOUR_SUPER_ADMIN_USER_ID_HERE

# === Database (Supabase) ===
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# === Google Social Authentication (OAuth 2.0) ===
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# === GitHub API (Repo Intelligence & Higher Rate Limits) ===
# Get from: https://github.com/settings/tokens (public repo scope)
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE

# === Payment Gateway (Razorpay) ===
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
PERSONAL_UPI_ID=YOUR_UPI_ID_FOR_FALLBACK_PAYMENT_HERE

# === Cloudflare DNS Integration (Custom Domains) ===
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID_HERE

# === Static Deployment Service (Netlify - Optional) ===
NETLIFY_TOKEN=YOUR_NETLIFY_TOKEN_HERE

# === Telegram Bot Integration (Optional) ===
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=ai_portfolio_generator_bot

# === Transactional Email Service ===
# Recommended for Cloud Deployments (Render Free Tier / Vercel Serverless):
# Render Free Tier strictly blocks raw outbound SMTP (ports 25, 465, 587).
# Providing RESEND_API_KEY (or BREVO_API_KEY) routes email over HTTPS (Port 443),
# completely eliminating connection timeouts.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
# BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# === SMTP Email Settings (Titan / Custom SMTP / Gmail) ===
# Note: For Render, outbound SMTP requires upgrading to a paid instance (e.g. Starter).
FROM_EMAIL="MyFolio <support@myfolio.tech>"
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@myfolio.tech
SMTP_PASS="YOUR_TITAN_EMAIL_PASSWORD_IN_QUOTES"

# Development / Local fallback: if true, signup won't fail if SMTP times out locally
ALLOW_OTP_DEV_FALLBACK=false

# === Lifecycle & Maintenance Security ===
CRON_SECRET=YOUR_CRON_SECRET_KEY_HERE
